rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isAdmin() {
      return request.auth != null
        && request.auth.token.email == 'anilkadam4444@gmail.com'
        && request.auth.token.email_verified == true;
    }

    match /books/{bookId} {
      allow read: if true;
      allow write: if false; // Managed server-side via /api/admin/books
    }

    match /users/{uid}/purchases/{bookId} {
      allow read: if (request.auth != null && request.auth.uid == uid) || isAdmin();
      allow write: if false; // Written only by /api/verify-payment & /api/razorpay-webhook
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
